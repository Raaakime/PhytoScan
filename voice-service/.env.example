# Copier en ".env" (ou passer ces variables à Docker). Voir README.md.
VOICE_SERVICE_API_TOKEN=               # obligatoire ; même valeur que VOICE_WOLOF_SERVICE_TOKEN côté backend
# openssl rand -hex 32

VOICE_SERVICE_DEVICE=auto              # auto | cpu | cuda
VOICE_SERVICE_MAX_CONCURRENT=2

VOICE_SERVICE_STT_MODEL=M9and2M/whisper-small-wolof
VOICE_SERVICE_TTS_MODEL=bilalfaye/speecht5_tts-wolof
VOICE_SERVICE_TTS_VOCODER=microsoft/speecht5_hifigan
VOICE_SERVICE_TTS_SPEAKER_EMBEDDING=/models/speaker.npy
# VOICE_SERVICE_HF_TOKEN=              # seulement pour un modèle « gated »
