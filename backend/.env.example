# Copier ce fichier en ".env" puis adapter les valeurs.

ENVIRONMENT=dev          # passer à "prod" en production (refuse alors la SECRET_KEY par défaut)
SECRET_KEY=changez-moi-par-une-longue-valeur-aleatoire

# --- Base de données : changer UNIQUEMENT cette ligne pour basculer ---
DATABASE_URL=sqlite:///./phytoscan.db
# DATABASE_URL=postgresql+psycopg://user:motdepasse@localhost:5432/phytoscan
# DATABASE_URL=mysql+pymysql://user:motdepasse@localhost:3306/phytoscan?charset=utf8mb4   (utf8mb4 : accents et wolof)

# --- Démarrage ---
# En développement : true (les tables sont créées automatiquement + plantes de démonstration)
# En production    : AUTO_CREATE_TABLES=false (les tables sont gérées par "alembic upgrade head")
#                    SEED_DEMO_PLANTS=false     (pas de plantes de démonstration)
AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
SEED_DEMO_PLANTS=true

# --- Authentification : false tant que le front n'a pas d'écran de connexion ---
AUTH_REQUIRED=false

# --- Modèle IA : "mock" (test) ou "custom" (votre vrai modèle ONNX) ---
ML_MODEL_BACKEND=mock
ML_MODEL_PATH=app/ml/weights/model.onnx
ML_LABELS_PATH=app/ml/labels.json

# --- Assistant vocal (voir README, section « Assistant vocal ») ---
VOICE_ENABLED=false
VOICE_MAX_AUDIO_SECONDS=30
VOICE_RATE_LIMIT_PER_MINUTE=6
VOICE_DAILY_QUOTA=100
VOICE_MAX_CONCURRENT=4

# --- Gemini : une clé pour la voix (fr/en) ET l'assistant. https://aistudio.google.com/ ---
# Offre GRATUITE : Google peut réutiliser les contenus envoyés (dont les voix) pour améliorer ses produits.
# Pour de vrais utilisateurs : activez la facturation (offre payante).
GEMINI_API_KEY=
VOICE_STT_PROVIDER=gemini               # gemini | openai | none
VOICE_TTS_PROVIDER=gemini               # gemini | openai | elevenlabs | none
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Erinome                # voix « Clear » ; essayez aussi Sulafat (chaleureuse), Achird (amicale)

# Assistant : "mock" = règles à mots-clés (gratuit, sans clé) ; "gemini" = LLM, avec repli automatique sur les règles
ASSISTANT_BACKEND=mock
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
ASSISTANT_LLM_LANGUAGES=fr,en           # le wolof reste sur les règles
ASSISTANT_LLM_RATE_PER_MINUTE=10
ASSISTANT_LLM_DAILY_QUOTA=200

# Alternative : API compatible OpenAI (OpenAI, passerelle interne, freellmapi en développement uniquement)
# VOICE_STT_PROVIDER=openai
# VOICE_TTS_PROVIDER=openai
# VOICE_OPENAI_BASE_URL=https://api.openai.com/v1
# VOICE_OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Wolof : adresse du microservice voice-service (vide = voix wolof désactivée)
VOICE_WOLOF_SERVICE_URL=
VOICE_WOLOF_SERVICE_TOKEN=

# --- CORS : adresses du front (liste JSON) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://192.168.1.2:5173"]
