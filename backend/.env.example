# Copier ce fichier en ".env" puis adapter les valeurs.

ENVIRONMENT=dev          # passer à "prod" en production (refuse alors la SECRET_KEY par défaut)
SECRET_KEY=changez-moi-par-une-longue-valeur-aleatoire

# --- Base de données : changer UNIQUEMENT cette ligne pour basculer ---
DATABASE_URL=sqlite:///./phytoscan.db
# DATABASE_URL=postgresql+psycopg://user:motdepasse@localhost:5432/phytoscan
# DATABASE_URL=mysql+pymysql://user:motdepasse@localhost:3306/phytoscan?charset=utf8mb4   (utf8mb4 : accents et wolof)

# --- Démarrage ---
# En développement : true (les tables sont créées automatiquement + plantes de démonstration)
# En production    : AUTO_CREATE_TABLES=false (les tables sont gérées par "alembic upgrade head")
#                    SEED_DEMO_PLANTS=false     (pas de plantes de démonstration)
AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
SEED_DEMO_PLANTS=true

# --- Authentification : false tant que le front n'a pas d'écran de connexion ---
AUTH_REQUIRED=false

# --- Modèle IA : "mock" (test) ou "custom" (votre vrai modèle ONNX) ---
ML_MODEL_BACKEND=mock
ML_MODEL_PATH=app/ml/weights/model.onnx
ML_LABELS_PATH=app/ml/labels.json

# --- CORS : adresses du front (liste JSON) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://192.168.1.2:5173"]
